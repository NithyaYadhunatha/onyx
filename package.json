{
  "name": "onyx",
  "version": "0.1.0",
  "description": "Onyx: an open-source AI agent that controls your Windows PC and Android phone by text or voice.",
  "license": "MIT",
  "type": "module",
  "main": "app/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "onyx": "cli/onyx.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "core": "node core/server.mjs",
    "app": "electron .",
    "cli": "node cli/onyx.mjs",
    "voice": "node scripts/voice.mjs",
    "autostart": "node scripts/autostart.mjs",
    "test": "node --test tests/ && node scripts/pytest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "croner": "^9.0.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^37.0.0"
  }
}
